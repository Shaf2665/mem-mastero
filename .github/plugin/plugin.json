{
  "name": "mem-mastero",
  "version": "0.12.0",
  "description": "Project knowledge, cross-device coding-agent sessions, and verified Claude archives in storage you own.",
  "author": {
    "name": "Mohammed Shafiq",
    "url": "https://github.com/Shaf2665"
  },
  "homepage": "https://github.com/Shaf2665/mem-mastero",
  "repository": "https://github.com/Shaf2665/mem-mastero",
  "license": "MIT",
  "keywords": [
    "memory",
    "sessions",
    "sync",
    "google-drive",
    "github",
    "codex",
    "copilot",
    "pi"
  ],
  "hooks": "hooks/copilot-hooks.json",
  "commands": "./commands/",
  "mcpServers": {
    "mem-mastero-memory": {
      "type": "local",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/memory-mcp.js"],
      "tools": ["memory_search", "memory_timeline", "memory_get", "memory_save", "memory_forget"]
    }
  }
}
